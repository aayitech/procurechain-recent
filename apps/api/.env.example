# Database
DATABASE_URL="postgresql://procurechain:procurechain@localhost:5432/procurechain?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Market data providers
# Free FX rates via frankfurter.app require no key.
# Commodities use Alpha Vantage's free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=""
# World Bank Pink Sheet commodity data needs no key.
# US macro indicators (CPI, PPI, Fed Funds Rate, Industrial Production) via FRED:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""
# Daily Brent and WTI via EIA Open Data: https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# AI Procurement Assistant — Cloudflare Workers AI. The browser talks only to
# this NestJS backend; never expose this token in the web application.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.2-3b-instruct"

# GoHighLevel (leave blank until you have credentials — leads are stored
# locally and the sync worker will simply skip the push and mark leads
# SYNC_FAILED with a clear reason until this is set)
GOHIGHLEVEL_API_KEY=""
GOHIGHLEVEL_LOCATION_ID=""

# Resend sends the six-digit passwordless login code. In production, both
# values are required and AUTH_EMAIL_FROM must use a verified sending domain.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="ProcureChain <login@your-verified-domain.com>"
