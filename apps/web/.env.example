# Base URL of the NestJS API. Used server-side by Next.js rewrites so the
# browser can call same-origin `/api/*` and avoid CORS in every environment.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public GoHighLevel survey shown on /book-demo and in the Ask Nader demo dialog.
NEXT_PUBLIC_GHL_DEMO_SURVEY_URL="https://api.leadconnectorhq.com/widget/survey/HSfuWm21CrWzWZ60UgST"

# Calendar shown after the Buyer Form survey is submitted.
NEXT_PUBLIC_GHL_CALENDAR_URL="https://api.leadconnectorhq.com/widget/bookings/kyle-boyd-personal-calendar-0a6tcvnie"
